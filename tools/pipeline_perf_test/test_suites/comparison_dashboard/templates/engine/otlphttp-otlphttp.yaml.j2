version: otel_dataflow/v1
policies:
  channel_capacity:
    control:
      node: 100
      pipeline: 100
    pdata: 100
  resources:
    core_allocation:
      type: core_set
      set:
        - start: {{core_start}}
          end: {{core_end}}
{%- if push_metrics_endpoint is defined and push_metrics_endpoint %}
{%- set push_service_name = "df-engine" %}
{%- set engine_log_level = "info" %}
{% include "push_metrics_engine.yaml.j2" %}
{%- else %}
engine:
  telemetry:
    logs:
      level: info
{%- endif %}
groups:
  default:
    pipelines:
      main:
        nodes:
          receiver:
            type: urn:otel:receiver:otlp
            config:
              protocols:
                http:
                  listening_addr: 0.0.0.0:4318
          exporter:
            type: urn:otel:exporter:otlp_http
            config:
              http:
                compression: {% if compression_method == "none" %}null{% else %}{{compression_method}}{% endif %}
              endpoint: http://{{backend_hostname}}:1235
              client_pool_size: {{ client_pool_size | default(1) }}
        connections:
          - from: receiver
            to: exporter
