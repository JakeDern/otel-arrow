# Must stay semantically identical to ../engine/otlp-demo-pipeline.yaml.j2.
#
# Reproduction of an external DFE vs OTC benchmark pipeline. Deviations from
# the original config (harness plumbing, plus one filter change):
#   - exporter endpoint points at the harness backend instead of an env var
#   - sending_queue.wait_for_result is templated (suite variable); all other
#     sending_queue settings stay at their defaults
#   - internal metrics are served on :8086 (harness scrape port) not :8888
#   - logs filter adds a drop condition for ERROR+ so it drops something (see below)
receivers:
  otlp:
    protocols:
      grpc: { endpoint: 0.0.0.0:4317 }
      http: { endpoint: 0.0.0.0:4318 }

processors:
  # Same two operations as the df_engine OPL query. The PII statement order matters: the flag is
  # set before the body is replaced.
  transform/logs:
    error_mode: ignore
    log_statements:
      - set(log.severity_text, "ERROR") where IsMatch(log.body, "(?i)(error|exception|panic|fatal)")
      - set(log.attributes["pii.email.detected"], "true") where IsMatch(log.body, "[a-zA-Z0-9._%+-]+@[a-zA-Z0-9._-]+")
      - set(log.body, Concat(["REDACTED:", SHA256(log.body)], "")) where IsMatch(log.body, "[a-zA-Z0-9._%+-]+@[a-zA-Z0-9._-]+")

  # Static enrichment only, to match df_engine (no k8s_attributes).
  resource/enrich:
    attributes:
      - { action: upsert, key: k8s.cluster.name, value: otel-arrow-demo }
      - { action: upsert, key: benchmark.engine, value: otelcol }

  # Logs: keep INFO and above, plus records with no severity, then drop ERROR and above.
  # The second condition is not in the original config: the synthetic loadgen emits no records
  # below INFO, so without it the filter would never drop anything. It drops the 5% of records
  # generated as ERROR (severity_number 17); the transform above only changes severity_text, so
  # it does not affect this rule. Traces: drop health checks.
  filter/drop:
    error_mode: ignore
    logs:
      log_record:
        - severity_number != SEVERITY_NUMBER_UNSPECIFIED and severity_number < SEVERITY_NUMBER_INFO
        - severity_number >= SEVERITY_NUMBER_ERROR
    traces:
      span:
        - attributes["url.path"] == "/health"

  # Defaults written out so the parity with df_engine is explicit.
  batch:
    send_batch_size: 8192
    send_batch_max_size: 0
    timeout: 200ms

exporters:
  otlp_http/out:
    endpoint: 'http://{{backend_hostname}}:1235'
    compression: gzip
    sending_queue:
      enabled: true
      wait_for_result: {{ wait_for_result | default(false) | lower }}

service:
  pipelines:
    logs:
      receivers: [otlp]
      processors: [transform/logs, resource/enrich, filter/drop, batch]
      exporters: [otlp_http/out]
    traces:
      receivers: [otlp]
      processors: [resource/enrich, filter/drop, batch]
      exporters: [otlp_http/out]
    metrics:
      receivers: [otlp]
      processors: [resource/enrich, batch]
      exporters: [otlp_http/out]
  telemetry:
    metrics:
      readers:
        - pull:
            exporter:
              prometheus: { host: 0.0.0.0, port: 8086 }
