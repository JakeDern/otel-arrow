version: otel_dataflow/v1
policies:
  channel_capacity:
    control:
      node: 100
      pipeline: 100
    pdata: 100
{%- if push_metrics_endpoint is defined and push_metrics_endpoint %}
{%- set push_service_name = "df-engine" %}
{%- set engine_log_level = "info" %}
{% include "push_metrics_engine.yaml.j2" %}
{%- else %}
engine:
  telemetry:
    logs:
      level: info
{%- endif %}
groups:
  default:
    pipelines:
      main:
        nodes:
          receiver:
            type: urn:otel:receiver:otlp
            config:
              protocols:
                grpc:
                  listening_addr: 0.0.0.0:4317
                  request_compression: gzip
                  wait_for_result: true
          exporter:
            type: urn:otel:exporter:otlp_grpc
            config:
              grpc_endpoint: http://{{backend_hostname}}:1235
              compression_method: gzip
        connections:
        - from: receiver
          to: exporter
